<% if photo %>
  <div class="country-banner">
    <%= image_tag(photo.image_url, alt: "#{photo.image_alt}", class: "country-banner__image") %>
    <% if current_page?(root_path) %>
      <h1 class="country-banner__header">The Country Club.</h1>
    <% elsif continent_or_region == "Caribbean" %>
      <h1 class="country-banner__header" id="country-banner__caribbean-header"><%= continent_or_region %></h1>
    <% else %>
      <h1 class="country-banner__header"><%= continent_or_region %></h1>
    <% end %>
    <%= render 'shared/unsplash_links', photo: photo %>
    <div class="arrow-container">
      <i class="fa-solid fa-chevron-down" data-action="click->scroll#scrollToFirstSection"></i>
    </div>
  </div>
<% end %>
