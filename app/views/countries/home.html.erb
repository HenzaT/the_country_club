<div class="home container" data-controller="scroll">
  <%= render 'shared/country_photo_banner', photo: @photo %>

  <section class="home-info">
    <section class="introduction" data-scroll-target="firstSection">
      <header>
        <h2 id="introduction">A travel tracker</h2>
        <p>For the curious traveller</p>
      </header>
      <ul class="introduction-text">
        <li>
          As someone who loves travelling and going down geography rabbit holes on Wikipedia, I built this app to
          merge these two interests together.
        </li>
        <li>
          Have your favourite countries and countries you want to visit all in one place.
        </li>
        <li>
          Be inspired by beautiful photos,
          courtesy of <a href="https://unsplash.com/?utm_source=the_country_club&utm_medium=referral" target="_blank">Unsplash</a>,
          and learn more about each country.
        </li>
        <li>
          Get suggestions from <a href="https://www.anthropic.com/claude">Claude</a> for activities and recommendations
          for the best time to visit.
        </li>
      </ul>
      <% if !user_signed_in? %>
        <%= link_to "Join the Club", new_user_registration_path, class: "btn" %>
      <% elsif %>
        <%= link_to "Member's Area", dashboard_path, class: "btn" %>
      <% end %>
    </section>

    <hr>

    <section class="features grid">
      <div>
        <header>
          <h3>Where Next?</h3>
          <p>Discover your next destination</p>
        </header>
        <ul class="features-list">
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-solid fa-map-location-dot"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Discover destinations</h4>
              <p class="feature-card__subtitle">Find your next holiday spot</p>
            </div>
          </li>
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-regular fa-lightbulb"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">AI activity suggestions</h4>
              <p class="feature-card__subtitle">Ideas and best time to visit</p>
            </div>
          </li>
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-regular fa-heart"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Wishlist</h4>
              <p class="feature-card__subtitle">Track your dream destinations</p>
            </div>
          </li>
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-solid fa-list-check"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Track your list</h4>
              <p class="feature-card__subtitle">See every country in one place</p>
            </div>
          </li>
        </ul>
      </div>

      <hr>

      <div>
        <header>
          <h3>Relive it</h3>
          <p>Everywhere you've been</p>
        </header>
        <ul class="features-list" id="list-column">
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-star"></i>
            <p class="feature-row__text">Add to favourites</p>
          </li>
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-calendar"></i>
            <p class="feature-row__text">Track visits and dates</p>
          </li>
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-rectangle-list"></i>
            <p class="feature-row__text">Add personal notes</p>
          </li>
          <li class="feature-row" id="coming-soon">
            <div class="left-group">
              <i class="feature-row__icon fa-regular fa-image"></i>
              <p class="feature-row__text">Upload trip photos</p>
            </div>
            <span class="pill">Coming soon</span>
          </li>
        </ul>
      </div>

      <hr>

      <div>
        <header>
          <h3>Be Curious</h3>
          <p>Learn something new about every country</p>
        </header>
        <ul class="features-list">
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-solid fa-info"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Country facts</h4>
              <p class="feature-card__subtitle">Key information at a glance</p>
            </div>
          </li>
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-solid fa-user-group"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Population size</h4>
              <p class="feature-card__subtitle">See how small or large a country is</p>
            </div>
          </li>
          <li class="feature-card">
            <div class="feature-card__icon-box">
              <i class="feature-card__icon fa-solid fa-dollar-sign"></i>
            </div>
            <div class="feature-card__text">
              <h4 class="feature-card__title">Currency exchange</h4>
              <p class="feature-card__subtitle">Get your travel money organised</p>
              <span class="pill">Coming soon</span>
            </div>
          </li>
          <li class="feature-card" id="centered">
            <%= link_to country_path(@random_country), class: "feature-card__link" do %>
              <i class="feature-card__icon orange fa-solid fa-arrow-up-right-from-square"></i>
              Visit a random country
            <% end %>
          </li>
        </ul>
      </div>

      <hr>

      <div>
        <header>
          <h3>Be prepared</h3>
          <p>Know what to expect before you land</p>
        </header>
        <ul class="features-list" id="list-column">
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-star"></i>
            <p class="feature-row__text">Check the weather</p>
          </li>
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-calendar"></i>
            <p class="feature-row__text">Search for a city or specific area</p>
          </li>
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-rectangle-list"></i>
            <p class="feature-row__text">Get AI activity suggestions that fit the weather</p>
          </li>
          <li class="feature-row">
            <i class="feature-row__icon fa-regular fa-image"></i>
            <%= link_to "Visit React Weather", "https://react-weather-claude-app-af1fc23c96a1.herokuapp.com/", class: "web-link" %>
          </li>
        </ul>
      </div>

      <hr>

    </section>
  </section>

  <footer>
    <p>
      All photos from Unsplash. No offence is meant to be caused by any of the photos.
    </p>
  </footer>
</div>
