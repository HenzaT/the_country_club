        Ask Claude
      </button>
      <div class="ai-text" data-claude-target="seasonalText"></div>
    </div>
  </div> %>

  <section class="container">
    <header>
      <h2>Information</h2>
    </header>
    <section class="grid">
      <article class="country-fact card">
        <%= image_tag(@country.flag, alt: @country.flag_alt, class: "country-fact__flag") %>
      </article>

      <%# <div class="country-card-info">
        <div class="clock" data-controller="clock">
          <div class="outer-clock-face">
            <div class="marking marking-one"></div>
            <div class="marking marking-two"></div>
            <div class="marking marking-three"></div>
            <div class="marking marking-four"></div>
          </div>
          <div class="inner-clock-face">
            <div class="hand hour-hand" data-clock-target="hourHand"></div>
            <div class="hand min-hand" data-clock-target="minsHand"></div>
            <div class="hand second-hand" data-clock-target="secondHand"></div>
          </div>
        </div>
        <div class="current-time">
          <%= Time.now.strftime('%B %e, %Y - %I:%M%P') %>
        <%# </div>
      </div> %>

      <article class="country-fact card">
        <header>
          <h3>Capital City</h3>
          <p><%= @country.capital %></p>
        </header>
        <div class="mapbox"
          data-controller="map"
          data-map-markers-value="<%= @capital_markers.to_json %>"
          data-map-api-key-value="<%= ENV['MAPBOX_TOKEN_KEY'] %>">
        </div>
      </article>

      <article class="country-fact card">
        <h3>Languages</h3>
        <% @country.languages.each do |language| %>
          <p><%= language unless language == "None" %></p>
        <% end %>
        <h3>Population</h3>
        <p><%= number_with_delimiter(@country.population, :delimiter => ',') %></p>
        <p><%= population_index(@country) %></p>
        <h3>Area</h3>
        <p><%= number_with_delimiter(@country.area, :delimiter => ',') %> km²</p>
        <p><%= area_index(@country) %></p>
      </article>

      <article class="country-fact card" data-controller="currency">
        <h3>Currency</h3>
        <p><%= "#{@country.currency} (#{@country.currency_code} / #{@country.currency_symbol})" %></p>
        <div class="user-inputs">
          <div class="input">
            <label for="gbp-input"><%= @base_gbp_code %></label>
            <input
              id="gbp-input"
              type="number"
              value="<%= @base_gbp_rate * 100 %>"
              autocomplete="off"
              inputmode="decimal"
              data-currency-target="gbpInput"
              data-action="keyup->currency#exchange"
            >
          </div>
          <p>=</p>
          <div class="input">
            <label for="other-input"><%= @country.currency_code %></label>
            <input
              id="other-input"
              type="number"
              value="<%= @country_rate * 100 %>"
              autocomplete="off"
              inputmode="decimal"
              data-currency-target="foreignCurrencyInput"
              data-action="keyup->currency#exchange"
            >
          </div>
        </div>
        <p>1 GBP = <%= "#{@country_rate_rounded} #{@country.currency_code}" %></p>
      </article>

      <% if current_user&.added_to_wishlist(@country) %>
        <%= link_to edit_country_wishlist_path(@country), class: "list-link" do %>
          <article class="wishlist card">
            <i class="fa-solid fa-paper-plane icon"></i>
            <%= render "delete_wishlist", country: @country %>
          </article>
        <% end %>
      <% else %>
        <%= link_to new_country_wishlist_path(@country), class: "list-link" do %>
          <article class="wishlist card">
            <i class="fa-regular fa-paper-plane icon"></i>
            <p>Add to wishlist</p>
          </article>
        <% end %>
      <% end %>

      <% if current_user&.added_to_favourite(@country) %>
        <%= link_to edit_country_favourite_path(@country), class: "list-link" do %>
          <article class="favourite card">
            <i class="fa-solid fa-heart icon"></i>
            <%= render "delete_favourite", country: @country %>
          </article>
        <% end %>
      <% else %>
        <%= link_to new_country_favourite_path(@country), class: "list-link" do %>
          <article class="favourite card">
            <i class="fa-regular fa-heart icon"></i>
            <p>Add to favourites</p>
          </article>
        <% end %>
      <% end %>

      <section class="favourite-photos">
        <% if current_user&.added_to_favourite(@country) %>
          <h2>Here are your photos from your trip</h2>
          <#% @favourite.photos.each do |photo| %>
            <%#= cl_image_tag photo.key, height: 300, width: 400, crop: :fill %>
          <#% end %>
        <% else %>
          <h2>Add a country to your favourites to add any photos from your trip</h2>
        <% end %>
      </section>
    </section>
  </section>

</div>
