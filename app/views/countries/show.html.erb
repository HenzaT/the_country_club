<%# Country show %>
<div class="country-page">
  <% if @country_photo %>
    <section class="country-banner">
      <%= image_tag(@country_photo.image_url, alt: "#{@country_photo.image_alt}", class: "country-banner__image") %>
      <h1 class="country-banner__header"><%= @country.name %></h1>

      <div class="image-icons">
        <% case %>
        <% when @wishlist_already_created && @favourite_already_created %>
          <div class="icons">
            <%= link_to edit_country_wishlist_path(@country) do %>
              <i class="fa-solid fa-paper-plane icon" alt="solid plane icon"></i>
            <% end %>
            <%= link_to edit_country_favourite_path(@country) do %>
              <i class="fa-solid fa-heart icon" alt="solid heart icon"></i>
            <% end %>
          </div>
        <% when @wishlist_already_created %>
          <div class="icons">
            <%= link_to edit_country_wishlist_path(@country) do %>
              <i class="fa-solid fa-paper-plane icon" alt="solid plane icon"></i>
            <% end %>
            <%= link_to new_country_favourite_path(@country) do %>
              <i class="fa-regular fa-heart icon" alt="empty heart icon"></i>
            <% end %>
          </div>
        <% when @favourite_already_created %>
          <div class="icons">
            <%= link_to new_country_wishlist_path(@country) do %>
              <i class="fa-regular fa-paper-plane icon" alt="empty plane icon"></i>
            <% end %>
            <%= link_to edit_country_favourite_path(@country) do %>
              <i class="fa-solid fa-heart icon" alt="solid heart icon"></i>
            <% end %>
          </div>
        <% else %>
          <div class="icons">
            <%= link_to new_country_wishlist_path(@country) do %>
              <i class="fa-regular fa-paper-plane icon" alt="empty plane icon"></i>
            <% end %>
            <%= link_to new_country_favourite_path(@country) do %>
              <i class="fa-regular fa-heart icon" alt="empty heart icon"></i>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="country-banner__attributions">
        <p>
          Photo by
          <%= link_to @country_photo.photographer_name, "#{@country_photo.photographer_name}?utm_source=the_country_club&utm_medium=referral", rel: 'noopener', class: "country-banner__link" %>
          on
          <%= link_to 'Unsplash', 'https://unsplash.com/?utm_source=the_country_club&utm_medium=referral', rel: 'noopener', class: "country-banner__link" %>
        </p>
      </div>
    </section>
  <% end %>
